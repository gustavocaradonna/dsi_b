# Copiar este archivo como .env y completar con la key propia.
# El archivo .env NUNCA se commitea (ya esta en .gitignore).

# API key de Google AI Studio: https://aistudio.google.com/apikey
# La misma key sirve para generacion de texto (Entrega 1) y para embeddings (Entrega 2):
# no hace falta una cuenta ni una key aparte.
GEMINI_API_KEY=

# Modelo a usar. Cualquier variante flash sirve para este lote (es barato).
GEMINI_MODEL=gemini-3.5-flash-lite

# Temperatura de extraccion. 0 = maxima reproducibilidad del contrato.
GEMINI_TEMPERATURE=0

# Modelo de embeddings (Entrega 2: pipeline_vectorial.py, vector_db.py, etl_purga.py).
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- Entrega 3: observabilidad con LangSmith (B.4) ---
# Key personal de https://smith.langchain.com (Settings > API Keys). NUNCA commitear el valor.
# Con LANGSMITH_TRACING=true, cada corrida de entrega_3/rag_pipeline.py queda trazada.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=alquiherramientas-entrega3
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- Entrega 3: evaluacion RAGAS (C) ---
# Modelo juez de RAGAS. Vacio = el mismo GEMINI_MODEL del pipeline.
RAGAS_LLM_MODEL=

# --- TP Final: agente y API ---
# Rondas maximas agente -> herramientas por mensaje (limite del grafo ReAct).
MAX_ITERACIONES=5
# Carpeta de los datos que genera el sistema (base vectorial, base SQL, memoria, logs), relativa a
# la raiz del repo. Esta en .gitignore y se reconstruye sola en el primer arranque.
DIR_DATOS=data
# Archivo SQLite de la memoria del agente (una conversacion por thread_id), dentro de DIR_DATOS.
RUTA_MEMORIA=memoria_agente.sqlite
# Tarifas para el costo estimado de /metricas (USD por millon de tokens). Coinciden con las que
# LangSmith usa para el modelo; en el free tier el costo real es 0.
PRECIO_ENTRADA_USD_1M=0.30
PRECIO_SALIDA_USD_1M=2.50
# Sugerido para el TP Final: un proyecto de LangSmith aparte del de la Entrega 3.
# LANGSMITH_PROJECT=alquiherramientas-tp-final
