# Copiar este archivo como .env y completar con la key propia.
# El archivo .env NUNCA se commitea (ya esta en .gitignore).

# API key de Google AI Studio: https://aistudio.google.com/apikey
# La misma key sirve para generacion de texto (Entrega 1) y para embeddings (Entrega 2):
# no hace falta una cuenta ni una key aparte.
GEMINI_API_KEY=

# Modelo a usar. Cualquier variante flash sirve para este lote (es barato).
GEMINI_MODEL=gemini-3.5-flash-lite

# Temperatura de extraccion. 0 = maxima reproducibilidad del contrato.
GEMINI_TEMPERATURE=0

# Modelo de embeddings (Entrega 2: pipeline_vectorial.py, vector_db.py, etl_purga.py).
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- Entrega 3: observabilidad con LangSmith (B.4) ---
# Key personal de https://smith.langchain.com (Settings > API Keys). NUNCA commitear el valor.
# Con LANGSMITH_TRACING=true, cada corrida de entrega_3/rag_pipeline.py queda trazada.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=alquiherramientas-entrega3
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- Entrega 3: evaluacion RAGAS (C) ---
# Modelo juez de RAGAS. Vacio = el mismo GEMINI_MODEL del pipeline.
RAGAS_LLM_MODEL=
