# Copiar este archivo como .env y completar con la key propia.
# El archivo .env NUNCA se commitea (ya esta en .gitignore).

# API key de Google AI Studio: https://aistudio.google.com/apikey
# La misma key sirve para generacion de texto (Entrega 1) y para embeddings (Entrega 2):
# no hace falta una cuenta ni una key aparte.
GEMINI_API_KEY=

# Modelo a usar. Cualquier variante flash sirve para este lote (es barato).
GEMINI_MODEL=gemini-3.5-flash-lite

# Temperatura de extraccion. 0 = maxima reproducibilidad del contrato.
GEMINI_TEMPERATURE=0

# Modelo de embeddings (Entrega 2: pipeline_vectorial.py, vector_db.py, etl_purga.py).
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
