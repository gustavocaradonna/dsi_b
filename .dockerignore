# Lo que NO viaja al build de Docker. El Dockerfile copia solo app/, tests/ y los requirements,
# pero el contexto entero se manda al daemon: esto evita mandar secretos y cientos de MB de datos.

# Secretos: nunca dentro de una imagen
.env
.env.*
!.env.example

# Datos generados (van en el volumen) y entornos locales
data/
.venv/
venv/
**/chroma_db/
**/faiss_index/
**/*.sqlite
**/*.sqlite-*
**/*.db
logs/

# Lo que no forma parte del sistema en producción
entregas/
evidencia/
.git/
.github/
.vscode/
.idea/
**/__pycache__/
**/*.pyc
.pytest_cache/
*.md
